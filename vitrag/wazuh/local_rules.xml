<!--
ACD Phase 1 — Custom Wazuh rules.

These rules fire on patterns from auth_api, product_api, and nginx logs.
They use rule_id ranges that Bhavya's normalizer already understands:
  5710-5720  → brute_force
  31100-31199 → web attacks (SQL injection / XSS)
  40100-40110 → port scans

Rule levels:
  level 5  → low
  level 8  → medium
  level 10 → high
  level 12 → critical
-->
<group name="acd_lab,authentication_failures,">

  <!-- 5710-5712: Auth API brute force detection -->
  <rule id="5710" level="5">
    <decoded_as>json</decoded_as>
    <match>AUTH_FAILURE</match>
    <description>auth_api: Failed login attempt.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="5711" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>auth_api: Multiple failed logins from same source IP (possible brute force).</description>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <rule id="5712" level="12" frequency="20" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>auth_api: Sustained brute force attack from single IP.</description>
    <group>authentication_failures,brute_force,attack,</group>
  </rule>

</group>

<group name="acd_lab,web,attack,">

  <!-- 31103: SQL injection signatures in product_api logs -->
  <rule id="31103" level="11">
    <match>SQL_ERROR|union.*select|or.*1=1|--|information_schema|sqlmap</match>
    <description>Web attack: SQL injection attempt detected.</description>
    <group>web_attack,sql_injection,attack,</group>
  </rule>

  <!-- 31105: XSS signatures -->
  <rule id="31105" level="9">
    <match>&lt;script|javascript:|onerror=|onload=</match>
    <description>Web attack: XSS attempt detected.</description>
    <group>web_attack,xss,attack,</group>
  </rule>

</group>

<group name="acd_lab,recon,">

  <!-- 40101: Port scan / nmap signatures from nginx access log -->
  <rule id="40101" level="8">
    <match>nmap|masscan|Nikto|sqlmap</match>
    <description>Reconnaissance tool signature in User-Agent (port scan / vuln scanner).</description>
    <group>recon,port_scan,attack,</group>
  </rule>

  <rule id="40102" level="10" frequency="50" timeframe="30">
    <if_matched_sid>40101</if_matched_sid>
    <same_source_ip />
    <description>Sustained reconnaissance from single IP.</description>
    <group>recon,port_scan,attack,</group>
  </rule>

</group>
